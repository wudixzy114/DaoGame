{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug DaoGame",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/mingw-debug/DaoGame.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
      "preLaunchTask": "Configure and Build DaoGame (Debug)",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Run Smoke Test",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/mingw-debug/DaoGame.exe",
      "args": [
        "--smoke-test"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
      "preLaunchTask": "Configure and Build DaoGame (Debug)",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
